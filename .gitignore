# Python virtual environment
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Test artifacts (generated video clips, temp dirs)
tests/tmp/
tests/tmp_*/

# App data: originals, compressed copies, logs, thumbnails. Can reach tens of GB.
VideoCompressor/

# Portable ffmpeg/exiftool/adb dropped in by setup
tools/

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs and local runtime state
*.log
server.pid
